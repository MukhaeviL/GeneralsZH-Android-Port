<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#07111A"
                android:centerColor="#0B1A25"
                android:endColor="#050B11" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#239CF5" />
        </shape>
    </item>
</layer-list>
